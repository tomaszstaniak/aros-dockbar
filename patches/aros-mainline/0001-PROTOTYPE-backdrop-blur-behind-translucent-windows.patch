+/****************************************************************************************/
+/* PROTOTYPE: blur behind translucent surfaces (HIDD_CompositeRequestExt.BackdropBlur)   */
+/****************************************************************************************/
+
+/*
+ * A surface with BackdropBlur shows what lies behind it blurred. When the
+ * surface is about to be blended, the render target holds exactly that:
+ * the screen bitmap and every surface further back, already composed. The
+ * part under the surface is blurred there, in place, then the surface is
+ * blended over it as usual; nothing of the surface itself is blurred.
+ *
+ * Reach. The blur is a box blur run BLUR_PASSES times in each direction:
+ * a pixel depends on everything within reach = BLUR_PASSES * radius of
+ * it, also outside the surface. A blurred surface is in turn behind every
+ * surface in front of it, so a change can travel through several blurring
+ * surfaces. HIDDCompositorPlanBlur() follows it back to front and gives
+ * the area whose shown pixels change (shown) and the area to compose so
+ * that each of them is computed from fresh pixels (composed: shown grown
+ * by the sum of the reaches of the blurring surfaces near it). While
+ * composing, blurvalid is the area whose pixels are right so far; after
+ * each blurring surface it shrinks by that surface's reach, and it still
+ * holds 'shown' at the end. Only 'shown' is copied to the display.
+ *
+ * What is in front. The screen bitmap near the surface also holds the
+ * ordinary windows in front of it. Their pixels (BlurFront, from
+ * layers.library) are not taken in: the blur is a normalised one, a mean
+ * over the pixels that do lie behind the surface only.
+ *
+ * Cache. A surface keeps its blurred background. A redraw of the surface's
+ * own content, with nothing else changed, takes it from there instead of
+ * blurring again; every other redraw that reaches the surface computes the
+ * affected part again and stores it. A new surface list (any layer
+ * operation: a move, a resize, another order) makes new nodes, which start
+ * without a cache.
+ *
+ * Only when composing off screen (surfacebitmap, surfacesem held, which
+ * also guards the scratch buffer): composed but unshown pixels may be
+ * wrong. On the display itself, with alpha screens (intermedbitmap), on
+ * scaled screens, or without memory for the scratch buffer the surface is
+ * blended unblurred, as without the request.
+ */
+#define BLUR_PASSES     2
+#define BLUR_MAXRADIUS  16
+#define BLUR_MAXREACH   (BLUR_PASSES * BLUR_MAXRADIUS)
+
+/*
+ * The request's extension, when its sender filled it in (CRF_EXTENDED,
+ * ExtSize). Called where the sender hands the request over (surface list
+ * or AttachSurface/UpdateSurface), under the write lock: BlurFront is
+ * copied there, as the sender changes its region again at the next hand
+ * over while composing goes on. Without memory for the copy: no blur.
+ */
+static void HIDDCompositorReadExt(struct HIDDCompositorData *compdata, struct SurfaceNode *sn, struct HIDD_CompositeRequest *req)
+{
+    struct HIDD_CompositeRequestExt *ext = (struct HIDD_CompositeRequestExt *)req;
+
+    sn->blur = 0;
+    if (sn->blurfront)
+        ClearRegion(sn->blurfront);
+    if (!(req->Flags & CRF_EXTENDED) ||
+        ext->ExtSize < offsetof(struct HIDD_CompositeRequestExt, BlurFront) + sizeof(ext->BlurFront) ||
+        !ext->BackdropBlur)
+        return;
+    if (ext->BlurFront)
+    {
+        if (!sn->blurfront)
+            sn->blurfront = NewRegion();
+        if (!sn->blurfront || !OrRegionRegion(ext->BlurFront, sn->blurfront))
+            return;
+    }
+    sn->blur = (ext->BackdropBlur > BLUR_MAXRADIUS) ? BLUR_MAXRADIUS : ext->BackdropBlur;
+}
+
+static void HIDDCompositorDropBlurCache(struct SurfaceNode *sn)
+{
+    if (sn->blurcache)
+        FreeVec(sn->blurcache);
+    sn->blurcache = NULL;
+    sn->blurcachevalid = FALSE;
+}
+
+/* Radius a surface is blurred with now, 0 when it is not */
+static LONG HIDDCompositorSurfaceBlur(struct StackBitMapNode *n, struct SurfaceNode *sn)
+{
+    if (!sn->blur || sn->opaque || (sn->plane >= 0) || !SURFACE_BLITTABLE(sn) || n->scaled ||
+        !sn->region || !sn->region->RegionRectangle)
+        return 0;
+    return sn->blur;
+}
+
+/* Is a surface that asks for a blur on the display? (The redraw then holds surfacesem throughout) */
+static BOOL HIDDCompositorAnyBlur(struct HIDDCompositorData *compdata)
+{
+    struct StackBitMapNode *n;
+    struct SurfaceNode *sn;
+
+    ForeachNode(&compdata->bitmapstack, n)
+    {
+        if (!n->hassurfaces || !(n->sbmflags & STACKNODEF_VISIBLE))
+            continue;
+        ForeachNode(&n->surfaces, sn)
+        {
+            if (sn->blur)
+                return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* r grown or shrunk by 'by', in LONG, kept within what a Rectangle holds */
+static WORD HIDDCompositorClampWord(LONG v)
+{
+    return (v < -32768) ? -32768 : (v > 32767) ? 32767 : (WORD)v;
+}
+
+static void HIDDCompositorGrowRectAny(struct Rectangle *r, LONG by)
+{
+    r->MinX = HIDDCompositorClampWord((LONG)r->MinX - by);
+    r->MinY = HIDDCompositorClampWord((LONG)r->MinY - by);
+    r->MaxX = HIDDCompositorClampWord((LONG)r->MaxX + by);
+    r->MaxY = HIDDCompositorClampWord((LONG)r->MaxY + by);
+}
+
+static void HIDDCompositorGrowRect(struct HIDDCompositorData *compdata, struct Rectangle *r, LONG by)
+{
+    r->MinX = (r->MinX - by < compdata->displayrect.MinX) ? compdata->displayrect.MinX : r->MinX - by;
+    r->MinY = (r->MinY - by < compdata->displayrect.MinY) ? compdata->displayrect.MinY : r->MinY - by;
+    r->MaxX = (r->MaxX + by > compdata->displayrect.MaxX) ? compdata->displayrect.MaxX : r->MaxX + by;
+    r->MaxY = (r->MaxY + by > compdata->displayrect.MaxY) ? compdata->displayrect.MaxY : r->MaxY + by;
+}
+
+/* The inverse: edges on the display's edge stay, there is nothing beyond them to read */
+static void HIDDCompositorShrinkRect(struct HIDDCompositorData *compdata, struct Rectangle *r, LONG by)
+{
+    if (r->MinX > compdata->displayrect.MinX) r->MinX += by;
+    if (r->MinY > compdata->displayrect.MinY) r->MinY += by;
+    if (r->MaxX < compdata->displayrect.MaxX) r->MaxX -= by;
+    if (r->MaxY < compdata->displayrect.MaxY) r->MaxY -= by;
+}
+
+static void HIDDCompositorUnionRect(struct Rectangle *into, struct Rectangle *r)
+{
+    if (r->MinX < into->MinX) into->MinX = r->MinX;
+    if (r->MinY < into->MinY) into->MinY = r->MinY;
+    if (r->MaxX > into->MaxX) into->MaxX = r->MaxX;
+    if (r->MaxY > into->MaxY) into->MaxY = r->MaxY;
+}
+
+struct BlurPlan
+{
+    struct Rectangle shown;     /* pixels that may change on the display */
+    struct Rectangle composed;  /* pixels to compose for them */
+};
+
+/*
+ * A change at 'change' (display relative): of the screen bitmap or of a
+ * surface behind everything when 'changed' is NULL, else of the content of
+ * surface 'changed' only. FALSE when no blurring surface is near: compose
+ * as without blur. The caches it reads (to leave out the margin of a
+ * surface whose own content alone changed) only count under surfacesem,
+ * as in HIDDCompositorRedrawVisibleRegionsGrown(); without it the answer
+ * is only a hint whether to go there.
+ */
+static BOOL HIDDCompositorPlanBlur(struct HIDDCompositorData *compdata, struct Rectangle *change,
+                                   struct SurfaceNode *changed, struct BlurPlan *plan)
+{
+    struct StackBitMapNode *n;
+    struct SurfaceNode *sn;
+    struct Rectangle a = *change, g, x;
+    BOOL started = (changed == NULL);
+    LONG all = 0, margin = 0;
+
+    /* Back to front: screens from the back of the stack, surfaces in list order */
+    for (n = (struct StackBitMapNode *)compdata->bitmapstack.mlh_TailPred; n->n.mln_Pred;
+         n = (struct StackBitMapNode *)n->n.mln_Pred)
+    {
+        if (!n->hassurfaces || !(n->sbmflags & STACKNODEF_VISIBLE))
+            continue;
+        ForeachNode(&n->surfaces, sn)
+        {
+            LONG reach = BLUR_PASSES * HIDDCompositorSurfaceBlur(n, sn);
+
+            if (sn == changed)
+            {
+                started = TRUE;     /* what is in front of it sees the change */
+                all += reach;
+                continue;
+            }
+            if (!reach)
+                continue;
+            all += reach;
+            if (!started)
+                continue;
+            g = a;
+            HIDDCompositorGrowRectAny(&g, reach);
+            if (AndRectRect(&g, &sn->region->bounds, &x))
+                HIDDCompositorUnionRect(&a, &x);
+        }
+    }
+    if (!all)
+        return FALSE;
+
+    /* The blurring surfaces whose pixels can be among those composed: each needs its reach of fresh pixels */
+    g = a;
+    HIDDCompositorGrowRectAny(&g, all);
+    ForeachNode(&compdata->bitmapstack, n)
+    {
+        if (!n->hassurfaces || !(n->sbmflags & STACKNODEF_VISIBLE))
+            continue;
+        ForeachNode(&n->surfaces, sn)
+        {
+            LONG reach = BLUR_PASSES * HIDDCompositorSurfaceBlur(n, sn);
+
+            /* Its own content changed and its blurred background is kept: nothing to read for it */
+            if (sn == changed && sn->blurcachevalid && sn->blurcache &&
+                AndRectRect(change, &sn->blurcachebox, &x) &&
+                x.MinX == change->MinX && x.MinY == change->MinY && x.MaxX == change->MaxX && x.MaxY == change->MaxY)
+                continue;
+            if (reach && AndRectRect(&g, &sn->region->bounds, &x))
+                margin += reach;
+        }
+    }
+    if (!margin)
+        return FALSE;
+
+    plan->shown = plan->composed = a;
+    if (!AndRectRect(&compdata->displayrect, &plan->shown, &plan->shown))
+        return FALSE;
+    plan->composed = plan->shown;
+    HIDDCompositorGrowRect(compdata, &plan->composed, margin);
+    return TRUE;
+}
+
+/*
+ * Normalised box blur of a w x h block of 4 UWORD channels per pixel:
+ * three colours premultiplied by a weight, and the weight (0 for a pixel
+ * that is not taken in). Rows, then columns; at the edges the mean of what
+ * there is. Divisions are multiplications by a table of 65536/n. The column
+ * pass keeps a running sum per column and walks the block row by row, so
+ * it reads memory in order; the input rows it still needs after writing
+ * over them are kept in a ring of radius + 1 rows.
+ */
+#define BLUR_CH 4
+#define HIDDCompositorBoxBlurWork(w, radius) \
+    ((UQUAD)sizeof(ULONG) * BLUR_CH * (w) + sizeof(ULONG) * (2 * (radius) + 2) + \
+     (UQUAD)sizeof(UWORD) * BLUR_CH * (w) * ((radius) + 2) + 16)
+
+static void HIDDCompositorBoxBlur(UWORD *p, LONG w, LONG h, LONG radius, UBYTE *work)
+{
+    ULONG *colsum = (ULONG *)work;
+    ULONG *inv = colsum + BLUR_CH * w;
+    UWORD *line = (UWORD *)(inv + 2 * radius + 2);
+    UWORD *ring = line + BLUR_CH * w;
+    LONG x, y, k, n, c;
+
+    for (k = 1; k <= 2 * radius + 1; k++)
+        inv[k] = 65536 / k;
+
+    /* Rows */
+    for (y = 0; y < h; y++)
+    {
+        UWORD *r = p + BLUR_CH * y * w;
+        ULONG s[BLUR_CH] = { 0, 0, 0, 0 };
+
+        n = 0;
+        for (k = 0; k <= radius && k < w; k++, n++)
+            for (c = 0; c < BLUR_CH; c++)
+                s[c] += r[BLUR_CH * k + c];
+        for (x = 0; x < w; x++)
+        {
+            LONG out = x - radius, in = x + radius + 1;
+
+            for (c = 0; c < BLUR_CH; c++)
+                line[BLUR_CH * x + c] = ((UQUAD)s[c] * inv[n]) >> 16;
+            if (out >= 0)
+            {
+                for (c = 0; c < BLUR_CH; c++)
+                    s[c] -= r[BLUR_CH * out + c];
+                n--;
+            }
+            if (in < w)
+            {
+                for (c = 0; c < BLUR_CH; c++)
+                    s[c] += r[BLUR_CH * in + c];
+                n++;
+            }
+        }
+        CopyMem(line, r, sizeof(UWORD) * BLUR_CH * w);
+    }
+
+    /* Columns */
+    for (x = 0; x < BLUR_CH * w; x++)
+        colsum[x] = 0;
+    n = 0;
+    for (k = 0; k <= radius && k < h; k++, n++)
+    {
+        UWORD *r = p + BLUR_CH * k * w;
+        for (x = 0; x < BLUR_CH * w; x++)
+            colsum[x] += r[x];
+    }
+    for (y = 0; y < h; y++)
+    {
+        LONG out = y - radius, in = y + radius + 1;
+        UWORD *r = p + BLUR_CH * y * w;
+        ULONG f = inv[n];
+
+        /* Row y is still needed when it leaves the window, radius rows on */
+        CopyMem(r, ring + BLUR_CH * w * (y % (radius + 1)), sizeof(UWORD) * BLUR_CH * w);
+        for (x = 0; x < BLUR_CH * w; x++)
+            r[x] = ((UQUAD)colsum[x] * f) >> 16;
+        if (out >= 0)
+        {
+            UWORD *o = ring + BLUR_CH * w * (out % (radius + 1));
+            for (x = 0; x < BLUR_CH * w; x++)
+                colsum[x] -= o[x];
+            n--;
+        }
+        if (in < h)
+        {
+            UWORD *i = p + BLUR_CH * in * w;
+            for (x = 0; x < BLUR_CH * w; x++)
+                colsum[x] += i[x];
+            n++;
+        }
+    }
+}
+
+/*
+ * Scratch memory for one blur, grown on demand. A larger buffer is
+ * allocated before the old one is let go: when that fails, the old one
+ * stays for the smaller areas it fits, and this area is shown unblurred.
+ */
+static UBYTE *HIDDCompositorBlurScratch(struct HIDDCompositorData *compdata, UQUAD need)
+{
+    UQUAD size;
+    UBYTE *buf;
+
+    if (need <= compdata->blurbufsize)
+        return compdata->blurbuf;
+    /* Round up, so that a surface growing by a few pixels does not reallocate */
+    size = (need + 65535) & ~(UQUAD)65535;
+    if (size > 0x7FFFFFFF)
+        return NULL;
+    buf = NULL;
+#ifdef COMPOSITOR_FAULT_INJECTION
+    {
+        BOOL fail;
+
+        Forbid();
+        fail = FindSemaphore("compositor.fail.blurscratch") != NULL;
+        Permit();
+        if (!fail)
+            buf = AllocVec((ULONG)size, MEMF_ANY);
+    }
+#else
+    buf = AllocVec((ULONG)size, MEMF_ANY);
+#endif
+    if (!buf)
+        return NULL;
+    if (compdata->blurbuf)
+        FreeVec(compdata->blurbuf);
+    compdata->blurbuf = buf;
+    compdata->blurbufsize = (ULONG)size;
+    if (compdata->blurstats)
+        compdata->blurstats->scratchbytes = compdata->blurbufsize;
+    return buf;
+}
+
+/* Clear the weight (and colours) of the source pixels in 'region' (display relative) */
+static void HIDDCompositorBlurExclude(UWORD *src, struct Rectangle *s, struct Region *region, LONG dx, LONG dy)
+{
+    struct RegionRectangle *rr;
+    LONG sw = s->MaxX - s->MinX + 1;
+
+    if (!region)
+        return;
+    for (rr = region->RegionRectangle; rr; rr = rr->Next)
+    {
+        struct Rectangle r, x;
+        LONG i, j;
+
+        r.MinX = rr->bounds.MinX + region->bounds.MinX + dx;
+        r.MinY = rr->bounds.MinY + region->bounds.MinY + dy;
+        r.MaxX = rr->bounds.MaxX + region->bounds.MinX + dx;
+        r.MaxY = rr->bounds.MaxY + region->bounds.MinY + dy;
+        if (!AndRectRect(&r, s, &x))
+            continue;
+        for (j = x.MinY; j <= x.MaxY; j++)
+        {
+            UWORD *p = src + BLUR_CH * ((j - s->MinY) * sw + (x.MinX - s->MinX));
+            for (i = x.MinX; i <= x.MaxX; i++, p += BLUR_CH)
+                p[0] = p[1] = p[2] = p[3] = 0;
+        }
+    }
+}
+
+/*
+ * The blurred background of surface 'sn' inside 't' (display relative,
+ * inside blurvalid shrunk by the reach, so every pixel within reach of 't'
+ * is right). Written to the render target where the surface is visible
+ * and not fully transparent; the surface's alpha weights it, so the
+ * antialiased rim of a rounded surface fades into the sharp surroundings.
+ * 'fromcache': take it from the surface's cache instead of blurring;
+ * 'filling': the cache is being filled (not valid yet) and gets the result.
+ * Called under surfacesem, which guards the caches. FALSE when it could
+ * not be done (no memory): nothing was written.
+ */
+static BOOL HIDDCompositorBlurBehind(struct HIDDCompositorData *compdata, OOP_Object *target,
+                                     struct StackBitMapNode *n, struct SurfaceNode *sn,
+                                     struct Rectangle *t, LONG radius, BOOL fromcache, BOOL filling)
+{
+    struct HIDD_CompositeRequest *req = SNREQ(sn);
+    struct Rectangle s = *t, *box = &sn->blurcachebox;
+    LONG sw, sh, tw, th, bw, x, y, i;
+    UQUAD need;
+    UBYTE *buf, *orig, *alpha, *visible, *work, *cache;
+    BOOL incache;
+    UWORD *src;
+    struct RegionRectangle *rr;
+
+    HIDDCompositorGrowRect(compdata, &s, BLUR_PASSES * radius);
+    sw = s.MaxX - s.MinX + 1;
+    sh = s.MaxY - s.MinY + 1;
+    tw = t->MaxX - t->MinX + 1;
+    th = t->MaxY - t->MinY + 1;
+    bw = box->MaxX - box->MinX + 1;
+    if (sw <= 0 || sh <= 0 || tw <= 0 || th <= 0)
+        return TRUE;
+    /* The cache, when there is one, covers all of t (it covers the surface) */
+    cache = sn->blurcache;
+    incache = cache && (sn->blurcachevalid || filling) && t->MinX >= box->MinX && t->MinY >= box->MinY &&
+              t->MaxX <= box->MaxX && t->MaxY <= box->MaxY;
+    if (fromcache && !incache)
+        return FALSE;
+
+    /* source as UWORDs, the original of t (ARGB), the surface's alpha of t (ARGB),
+       a visibility byte per pixel of t, work for the blur; UQUAD: no overflow
+       whatever the sizes (they are limited by the display anyway) */
+    need = (UQUAD)sizeof(UWORD) * BLUR_CH * sw * sh + (UQUAD)9 * tw * th +
+           (fromcache ? 0 : HIDDCompositorBoxBlurWork(sw, radius)) + 16;
+    if (!(buf = HIDDCompositorBlurScratch(compdata, need)))
+    {
+        if (compdata->blurstats)
+            compdata->blurstats->skipped++;
+        return FALSE;
+    }
+    src   = (UWORD *)buf;
+    orig    = (UBYTE *)(src + BLUR_CH * sw * sh);
+    alpha   = orig + 4 * tw * th;
+    visible = alpha + 4 * tw * th;
+    work    = (UBYTE *)(((IPTR)(visible + tw * th) + 7) & ~(IPTR)7);
+
+    HIDD_BM_GetImage(target, orig, tw * 4, t->MinX, t->MinY, tw, th, vHidd_StdPixFmt_ARGB32);
+
+    if (!fromcache)
+    {
+        /* The source block, read into the start of 'src' as bytes, then widened in place from the end */
+        UBYTE *bytes = (UBYTE *)src;
+
+        HIDD_BM_GetImage(target, bytes, sw * 4, s.MinX, s.MinY, sw, sh, vHidd_StdPixFmt_ARGB32);
+        for (i = sw * sh - 1; i >= 0; i--)
+        {
+            UWORD r = bytes[4 * i + 1], g = bytes[4 * i + 2], b = bytes[4 * i + 3];
+
+            src[BLUR_CH * i]     = r << 6;
+            src[BLUR_CH * i + 1] = g << 6;
+            src[BLUR_CH * i + 2] = b << 6;
+            src[BLUR_CH * i + 3] = 255 << 6;
+        }
+        /* What lies in front of the surface is not behind it */
+        HIDDCompositorBlurExclude(src, &s, sn->blurfront, n->leftedge, n->topedge);
+        for (i = 0; i < BLUR_PASSES; i++)
+            HIDDCompositorBoxBlur(src, sw, sh, radius, work);
+    }
+
+    if (req->AlphaMode == vHidd_CompAlpha_PerPixel)
+    {
+        WORD ax = req->Src.MinX + (t->MinX - (req->Dest.MinX + n->leftedge));
+        WORD ay = req->Src.MinY + (t->MinY - (req->Dest.MinY + n->topedge));
+
+        HIDD_BM_GetImage(req->BitMap, alpha, tw * 4, ax, ay, tw, th, vHidd_StdPixFmt_ARGB32);
+    }
+    else
+    {
+        for (i = 0; i < tw * th; i++)
+            alpha[4 * i] = 0xFF;
+    }
+
+    /* Only where the surface is visible: elsewhere in t the target keeps what it has */
+    {
+        memset(visible, 0, tw * th);
+        for (rr = sn->region->RegionRectangle; rr; rr = rr->Next)
+        {
+            struct Rectangle r, v;
+
+            r.MinX = rr->bounds.MinX + sn->region->bounds.MinX;
+            r.MinY = rr->bounds.MinY + sn->region->bounds.MinY;
+            r.MaxX = rr->bounds.MaxX + sn->region->bounds.MinX;
+            r.MaxY = rr->bounds.MaxY + sn->region->bounds.MinY;
+            if (AndRectRect(&r, t, &v))
+                for (y = v.MinY; y <= v.MaxY; y++)
+                    memset(visible + (y - t->MinY) * tw + (v.MinX - t->MinX), 1, v.MaxX - v.MinX + 1);
+        }
+
+        for (y = 0; y < th; y++)
+        {
+            UBYTE *o = orig + 4 * y * tw;
+            UBYTE *a = alpha + 4 * y * tw;
+            UBYTE *vis = visible + y * tw;
+            /* the blurred value: from the cache, or from the blurred source */
+            UBYTE *cached = incache ? cache + 4 * ((t->MinY - box->MinY + y) * bw + (t->MinX - box->MinX)) : NULL;
+            UWORD *b = src + BLUR_CH * ((t->MinY - s.MinY + y) * sw + (t->MinX - s.MinX));
+
+            for (x = 0; x < tw; x++, o += 4, a += 4, b += BLUR_CH)
+            {
+                ULONG w = (a[0] >= 64) ? 256 : 4 * a[0];
+                UBYTE blurred[3];
+                LONG c;
+
+                if (fromcache)
+                {
+                    blurred[0] = cached[4 * x + 1];
+                    blurred[1] = cached[4 * x + 2];
+                    blurred[2] = cached[4 * x + 3];
+                }
+                else
+                {
+                    if (b[3])
+                        for (c = 0; c < 3; c++)
+                            blurred[c] = ((ULONG)b[c] * 255 + b[3] / 2) / b[3];
+                    else
+                        for (c = 0; c < 3; c++)     /* nothing behind within reach: the pixel as it is */
+                            blurred[c] = o[c + 1];
+                    if (cached)
+                        cached[4 * x + 1] = blurred[0], cached[4 * x + 2] = blurred[1], cached[4 * x + 3] = blurred[2];
+                }
+                if (!w || !vis[x])
+                    continue;
+                for (c = 1; c < 4; c++)
+                    o[c] = o[c] + (((LONG)blurred[c - 1] - (LONG)o[c]) * (LONG)w) / 256;
+            }
+        }
+    }
+    HIDD_BM_PutImage(target, compdata->gc, orig, tw * 4, t->MinX, t->MinY, tw, th, vHidd_StdPixFmt_ARGB32);
+
+    if (compdata->blurstats)
+    {
+        if (fromcache)
+            compdata->blurstats->cached++;
+        else
+        {
+            compdata->blurstats->blurs++;
+            compdata->blurstats->sourcepixels += sw * sh;
+        }
+        compdata->blurstats->blurpixels += tw * th;
+        compdata->blurstats->lastblur = *t;
+    }
+    return TRUE;
+}
+
+/*
+ * Blur behind one blurring surface before its rectangles are blended: once
+ * for all of them (the bounding box of its visible part within what is
+ * composed and right), so that no rectangle reads another one already
+ * blended. Fills the surface's cache when the whole surface was blurred.
+ */
+static void HIDDCompositorBlurSurface(struct HIDDCompositorData *compdata, OOP_Object *renderTarget,
+                                      struct StackBitMapNode *n, struct SurfaceNode *sn, struct Rectangle *drawrect)
+{
+    LONG radius = HIDDCompositorSurfaceBlur(n, sn), reach = BLUR_PASSES * radius;
+    struct Rectangle k = compdata->blurvalid, t, d;
+    BOOL fromcache, whole, filling = FALSE;
+
+    if (!radius)
+        return;
+    d = drawrect ? *drawrect : compdata->displayrect;
+    if (renderTarget != compdata->surfacebitmap)
+    {
+        /*
+         * Composed on the display, or for alpha screens: blended unblurred,
+         * and what lies behind it may have changed without its cache
+         * knowing: mark it stale, under surfacesem like every use of it
