+            RemSemaphore(fail);
+        hidden = OpenScreenTags(NULL, SA_LikeWorkbench, TRUE, SA_Behind, TRUE, SA_Quiet, TRUE,
+            SA_Title, (IPTR)"backdropblur", TAG_DONE);
+        read_stats(&s0);
+        if (hidden)
+        {
+            MoveScreen(hidden, 0, 1);
+            MoveScreen(hidden, 0, -1);
+        }
+        read_stats(&s1);
+        print_stats("recovered", &s0, &s1);
+        fflush(out);
+        Delay(150);
+        if (hidden)
+            CloseScreen(hidden);
+        if (big)
+            CloseWindow(big);
+        if (fail)
+            FreeMem(fail, sizeof(*fail));
+    }
+    else if (!strcmp(test, "show"))
+    {
+        for (i = 0; i < seconds * 5 && !(SetSignal(0, 0) & SIGBREAKF_CTRL_C); i++)
+        {
+            back_scroll(back);
+            Delay(10);
+        }
+        read_stats(&s1);
+        print_stats("show", &s0, &s1);
+    }
