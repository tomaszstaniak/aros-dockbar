diff --git a/developer/debug/test/intuition/backdropblur.c b/developer/debug/test/intuition/backdropblur.c
new file mode 100644
index 0000000000..f7eda45c03
--- /dev/null
+++ b/developer/debug/test/intuition/backdropblur.c
@@ -0,0 +1,584 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: PROTOTYPE test of WA_BackdropBlur: translucent composited windows
+          that blur what lies behind them, and what that costs.
+
+    An ordinary window BACK (600x200 at 100,180) shows lines of text; one
+    or more GLASS windows (borderless, WA_AlphaSurface, a white tint of
+    alpha 90 with rounded corners, opaque squares and text on it) lie over
+    it. With WA_BackdropBlur the text behind each glass is blurred, the
+    squares and text on the glass stay sharp, and the blur takes in what
+    lies around the glass's edge.
+
+    TEST:
+      rest    nothing changes for SECONDS; the compositor must do nothing
+      scroll  BACK scrolls its text by 2 lines and writes a new one, FRAMES
+              times; time per step (the composition happens in the call)
+      update  the first GLASS writes its own pixels again, FRAMES times
+      near    an 8x8 box on BACK, 3 pixels left of the first GLASS,
+              changes colour FRAMES times
+      far     the same box 120 pixels left of it
+      show    stays open SECONDS for captures, scrolling BACK slowly
+
+    MODE: BLUR (default, RADIUS n, default 6), PLAIN (alpha, no blur),
+    NONE (no glass). GLASSES n (1-4).
+
+    The prototype compositor counts its work in a semaphore named
+    "compositor.prototype.blur"; the test prints how the counters moved.
+    Results go to LOG (default: the console).
+
+    Usage: backdropblur [TEST=name] [MODE=BLUR|PLAIN|NONE] [RADIUS=n]
+                        [GLASSES=n] [FRAMES=n] [SECONDS=n] [LOG=file]
+*/
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/graphics.h>
+#include <proto/intuition.h>
+#include <proto/cybergraphics.h>
+#include <proto/timer.h>
+#include <exec/memory.h>
+#include <exec/semaphores.h>
+#include <exec/execbase.h>
+#include <devices/timer.h>
+#include <intuition/intuition.h>
+#include <graphics/clip.h>
+#include <graphics/rastport.h>
+#include <cybergraphx/cybergraphics.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef WA_BackdropBlur
+#define WA_BackdropBlur (WA_Dummy + 107)
+#endif
+
+/* Layout of the prototype's counters (gfx_compositor.h, version 1) */
+struct BlurStats
+{
+    struct SignalSemaphore ss;
+    ULONG version, redraws, grownpixels, shownpixels, blurs, blurpixels, sourcepixels, skipped, scratchbytes, cached, held;
+    struct Rectangle lastblur;
+};
+
+#define BACKX 100
+#define BACKY 180
+#define BACKW 600
+#define BACKH 200
+#define GW 400
+#define GH 64
+
+struct Device *TimerBase;
+static struct timerequest treq;
+static ULONG efreq;
+static FILE *out;
+
+static double now_ms(void)
+{
+    struct EClockVal e;
+    ReadEClock(&e);
+    return ((double)e.ev_hi * 4294967296.0 + e.ev_lo) * 1000.0 / efreq;
+}
+
+/* Summed over every compositor (one per display); 0 when there is none */
+static int read_stats(struct BlurStats *sum)
+{
+    struct Node *n;
+    int found = 0;
+
+    memset(sum, 0, sizeof(*sum));
+    Forbid();
+    for (n = SysBase->SemaphoreList.lh_Head; n->ln_Succ; n = n->ln_Succ)
+    {
+        struct BlurStats *s = (struct BlurStats *)n;
+
+        if (!n->ln_Name || strcmp(n->ln_Name, "compositor.prototype.blur") || s->version != 3)
+            continue;
+        found++;
+        sum->redraws += s->redraws;
+        sum->grownpixels += s->grownpixels;
+        sum->shownpixels += s->shownpixels;
+        sum->blurs += s->blurs;
+        sum->blurpixels += s->blurpixels;
+        sum->sourcepixels += s->sourcepixels;
+        sum->skipped += s->skipped;
+        sum->scratchbytes += s->scratchbytes;
+        sum->cached += s->cached;
+        sum->held += s->held;
+        if (s->blurs)
+            sum->lastblur = s->lastblur;
+    }
+    Permit();
+    return found;
+}
+
+static void print_stats(const char *what, struct BlurStats *a, struct BlurStats *b)
+{
+    fprintf(out, "%s: redraws %lu grown %lu shown %lu blurs %lu blurred %lu read %lu skipped %lu scratch %lu cached %lu last %d,%d-%d,%d\n",
+        what, (unsigned long)(b->redraws - a->redraws), (unsigned long)(b->grownpixels - a->grownpixels),
+        (unsigned long)(b->shownpixels - a->shownpixels), (unsigned long)(b->blurs - a->blurs),
+        (unsigned long)(b->blurpixels - a->blurpixels), (unsigned long)(b->sourcepixels - a->sourcepixels),
+        (unsigned long)(b->skipped - a->skipped), (unsigned long)b->scratchbytes, (unsigned long)(b->cached - a->cached),
+        b->lastblur.MinX, b->lastblur.MinY, b->lastblur.MaxX, b->lastblur.MaxY);
+}
+
+static int cmp(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y;
+}
+
+static void print_times(const char *what, double *t, int n)
+{
+    double sum = 0;
+    int i;
+    if (n <= 0) return;
+    for (i = 0; i < n; i++) sum += t[i];
+    qsort(t, n, sizeof(double), cmp);
+    fprintf(out, "%s: n %d mean %.3f ms median %.3f ms p90 %.3f ms max %.3f ms\n",
+        what, n, sum / n, t[n / 2], t[(n * 9) / 10], t[n - 1]);
+}
+
+/* The glass: white tint of alpha 90, rounded corners with a soft rim, opaque squares */
+static void glass_pixels(ULONG *px)
+{
+    int x, y;
+    for (y = 0; y < GH; y++)
+        for (x = 0; x < GW; x++)
+        {
+            UBYTE *p = (UBYTE *)&px[y * GW + x];
+            int dx = x < 12 ? 12 - x : x > GW - 13 ? x - (GW - 13) : 0;
+            int dy = y < 12 ? 12 - y : y > GH - 13 ? y - (GH - 13) : 0;
+            int d2 = dx * dx + dy * dy, a = 90;
+            int sq = (x % 64) >= 16 && (x % 64) < 48 && y >= 16 && y < 48;
+            if (d2 > 144) a = 0;
+            else if (d2 > 110) a = 45;
+            p[0] = a; p[1] = 0xff; p[2] = 0xff; p[3] = 0xff;
+            if (sq && a)
+            {
+                int edge = (x % 64) == 16 || (x % 64) == 47 || y == 16 || y == 47;
+                p[0] = 0xff;
+                p[1] = edge ? 0 : (UBYTE)(x * 3);
+                p[2] = edge ? 0 : 0x80;
+                p[3] = edge ? 0 : (UBYTE)(255 - x / 2);
+            }
+        }
+}
+
+static int line_no;
+
+static void back_line(struct Window *w, int y)
+{
+    char buf[96];
+    struct RastPort *rp = w->RPort;
+    snprintf(buf, sizeof buf, "%05d The quick brown fox jumps over the lazy dog 0123456789 ABCDEFGHIJ", line_no++);
+    SetAPen(rp, 1);
+    SetBPen(rp, 0);
+    SetDrMd(rp, JAM2);
+    Move(rp, 4, y + rp->TxBaseline);
+    Text(rp, (CONST_STRPTR)buf, strlen(buf));
+}
+
+static void back_fill(struct Window *w)
+{
+    int y;
+    SetAPen(w->RPort, 0);
+    RectFill(w->RPort, 0, 0, BACKW - 1, BACKH - 1);
+    for (y = 0; y + w->RPort->TxHeight <= BACKH; y += w->RPort->TxHeight)
+        back_line(w, y);
+}
+
+static void back_scroll(struct Window *w)
+{
+    int lh = w->RPort->TxHeight;
+    ScrollRaster(w->RPort, 0, 2 * lh, 0, 0, BACKW - 1, BACKH - 1);
+    back_line(w, BACKH - 2 * lh - (BACKH % lh));
+    back_line(w, BACKH - lh - (BACKH % lh));
+}
+
+/* TEST=race: two helper processes */
+static struct Window *race_glass, *race_back;
+static ULONG *race_px;
+static struct Task *race_parent;
+static volatile int race_b_done;
+
+static void race_fill(void)
+{
+    /* The glass rewrites all of itself: its cache, stale, is filled again (and held there) */
+    WritePixelArray(race_px, 0, 0, GW * 4, race_glass->RPort, 0, 0, GW, GH, RECTFMT_ARGB);
+    Signal(race_parent, SIGBREAKF_CTRL_E);
+}
+
+static void race_invalidate(void)
+{
+    /* A change next to the glass, composed without the off-screen bitmap: marks its cache stale */
+    int bx = 200 - BACKX - 3 - 8, by = 240 - BACKY + 20;
+
+    SetAPen(race_back->RPort, 2);
+    RectFill(race_back->RPort, bx, by, bx + 7, by + 7);
+    race_b_done = 1;
+    Signal(race_parent, SIGBREAKF_CTRL_F);
+}
+
+static struct SignalSemaphore *race_name(const char *name)
+{
+    struct SignalSemaphore *ss = AllocMem(sizeof(*ss), MEMF_PUBLIC | MEMF_CLEAR);
+
+    if (ss)
+    {
+        ss->ss_Link.ln_Name = (char *)name;
+        ss->ss_Link.ln_Pri = 0;
+        AddSemaphore(ss);
+    }
+    return ss;
+}
+
+static void race_unname(struct SignalSemaphore *ss)
+{
+    if (ss)
+    {
+        RemSemaphore(ss);
+        FreeMem(ss, sizeof(*ss));
+    }
+}
+
+int main(void)
+{
+    IPTR args[8] = { 0 };
+    struct RDArgs *rda = ReadArgs("TEST/K,MODE/K,RADIUS/N,GLASSES/N,FRAMES/N,SECONDS/N,LOG/K,SCENE/K", args, NULL);
+    const char *scene = (rda && args[7]) ? (const char *)args[7] : NULL;
+    const char *test = (rda && args[0]) ? (const char *)args[0] : "scroll";
+    const char *mode = (rda && args[1]) ? (const char *)args[1] : "BLUR";
+    int radius = (rda && args[2]) ? *(LONG *)args[2] : 6;
+    int glasses = (rda && args[3]) ? *(LONG *)args[3] : 1;
+    int frames = (rda && args[4]) ? *(LONG *)args[4] : 200;
+    int seconds = (rda && args[5]) ? *(LONG *)args[5] : 10;
+    int none = !strcasecmp(mode, "NONE"), blur = !strcasecmp(mode, "BLUR");
+    struct Window *back, *glass[4] = { NULL, NULL, NULL, NULL };
+    static const WORD gpos_default[4][2] = { {200, 240}, {180, 330}, {420, 100}, {60, 470} };
+    /* SCENE: overlap2 and chain3 stack glasses over each other, the others use one glass */
+    static const WORD gpos_overlap[4][2] = { {200, 240}, {300, 270}, {400, 300}, {60, 470} };
+    const WORD (*gpos)[2] = gpos_default;
+    struct Window *front = NULL;
+    struct BlurStats s0, s1;
+    double *times;
+    ULONG *px;
+    ULONG mem0, mem1, mem2;
+    int i, rc = 0, have;
+
+    out = (rda && args[6]) ? fopen((const char *)args[6], "w") : stdout;
+    if (!out) out = stdout;
+    if (glasses < 1) glasses = 1;
+    if (glasses > 4) glasses = 4;
+    if (scene)
+    {
+        if (!strcmp(scene, "overlap2")) glasses = 2, gpos = gpos_overlap;
+        else if (!strcmp(scene, "chain3")) glasses = 3, gpos = gpos_overlap;
+        else glasses = 1;
+    }
+    if (none) glasses = 0;
+
+    if (OpenDevice("timer.device", UNIT_ECLOCK, (struct IORequest *)&treq, 0))
+        return 20;
+    TimerBase = treq.tr_node.io_Device;
+    {
+        struct EClockVal e;
+        efreq = ReadEClock(&e);
+    }
+    times = malloc(sizeof(double) * (frames > 0 ? frames : 1));
+    px = malloc(GW * GH * 4);
+    if (!times || !px)
+        return 20;
+    glass_pixels(px);
+
+    back = OpenWindowTags(NULL, WA_Left, BACKX, WA_Top, BACKY, WA_Width, BACKW, WA_Height, BACKH,
+        WA_Borderless, TRUE, WA_Activate, FALSE, WA_SmartRefresh, TRUE, TAG_DONE);
+    if (!back)
+    {
+        fprintf(out, "no window\n");
+        return 20;
+    }
+    back_fill(back);
+
+    Delay(25);
+    mem0 = AvailMem(MEMF_ANY);
+    have = read_stats(&s0);
+    for (i = 0; i < glasses; i++)
+    {
+        glass[i] = OpenWindowTags(NULL, WA_Left, gpos[i][0], WA_Top, gpos[i][1], WA_Width, GW, WA_Height, GH,
+            WA_Borderless, TRUE, WA_Activate, FALSE, WA_AlphaSurface, TRUE,
+            blur ? WA_BackdropBlur : TAG_IGNORE, radius, TAG_DONE);
+        if (!glass[i])
+            break;
+        WritePixelArray(px, 0, 0, GW * 4, glass[i]->RPort, 0, 0, GW, GH, RECTFMT_ARGB);
+    }
+    Delay(25);
+    mem1 = AvailMem(MEMF_ANY);
+    fprintf(out, "test %s mode %s radius %d glasses %d (opened %d, composited %d) compositors with counters %d\n",
+        test, mode, blur ? radius : 0, glasses, i,
+        (glasses && glass[0]) ? ((glass[0]->WLayer->Flags & LAYERCOMPOSITED) ? 1 : 0) : 0,
+        have);
+    fprintf(out, "memory: before glass %lu, after %lu (used %ld)\n",
+        (unsigned long)mem0, (unsigned long)mem1, (long)(mem0 - mem1));
+    if (have) { read_stats(&s1); print_stats("opening", &s0, &s1); }
+
+    read_stats(&s0);
+    if (!strcmp(test, "rest"))
+    {
+        Delay(seconds * 50);
+        read_stats(&s1);
+        print_stats("rest", &s0, &s1);
+    }
+    else if (!strcmp(test, "scroll") || !strcmp(test, "update") || !strcmp(test, "near") || !strcmp(test, "far"))
+    {
+        int boxx = !strcmp(test, "far") ? gpos[0][0] - BACKX - 120 : gpos[0][0] - BACKX - 3 - 8;
+        int boxy = gpos[0][1] - BACKY + 20;
+        for (i = 0; i < frames && !(SetSignal(0, 0) & SIGBREAKF_CTRL_C); i++)
+        {
+            double t0 = now_ms();
+            if (!strcmp(test, "scroll"))
+                back_scroll(back);
+            else if (!strcmp(test, "update"))
+            {
+                if (glass[0])
+                    WritePixelArray(px, 0, 0, GW * 4, glass[0]->RPort, 0, 0, GW, GH, RECTFMT_ARGB);
+            }
+            else
+            {
+                SetAPen(back->RPort, (i & 1) ? 1 : 2);
+                RectFill(back->RPort, boxx, boxy, boxx + 7, boxy + 7);
+            }
+            times[i] = now_ms() - t0;
+            Delay(1);
+        }
+        read_stats(&s1);
+        print_times(test, times, i);
+        print_stats(test, &s0, &s1);
+    }
+    else if (!strcmp(test, "scene") && scene)
+    {
+        /*
+         * For captures from outside: 3 s still ("base"), then a small change
+         * next to the first glass ("partial": composed as a small redraw),
+         * then 3 s after a redraw of the whole display ("full"), which must
+         * look exactly like "partial". occlude: an opaque red window in
+         * front of a corner of the glass; split: an opaque red window in
+         * front of its middle, cutting what is seen of the glass into
+         * rectangles. The red must not show in the blur.
+         */
+        struct Screen *hidden;
+        int boxx = gpos[0][0] - BACKX - 3 - 8, boxy = gpos[0][1] - BACKY + 20;
+
+        /* occluderef: the glass of occlude without the window in front, for comparison */
+        if (!strcmp(scene, "occlude") || !strcmp(scene, "split"))
+        {
+            int split = !strcmp(scene, "split");
+            front = OpenWindowTags(NULL, WA_Left, split ? 360 : 480, WA_Top, split ? 220 : 200,
+                WA_Width, split ? 60 : 150, WA_Height, split ? 104 : 80,
+                WA_Borderless, TRUE, WA_Activate, FALSE, TAG_DONE);
+            if (front)
+            {
+                FillPixelArray(front->RPort, 0, 0, front->Width, front->Height, 0xFF0000);
+            }
+        }
+        fprintf(out, "scene %s: base\n", scene); fflush(out);
+        Delay(150);
+        read_stats(&s0);
+        SetAPen(back->RPort, 3);
+        RectFill(back->RPort, boxx, boxy, boxx + 7, boxy + 7);
+        read_stats(&s1);
+        print_stats("partial", &s0, &s1);
+        fflush(out);
+        Delay(150);
+        hidden = OpenScreenTags(NULL, SA_LikeWorkbench, TRUE, SA_Behind, TRUE, SA_Quiet, TRUE,
+            SA_Title, (IPTR)"backdropblur", TAG_DONE);
+        read_stats(&s0);
+        if (hidden)
+        {
+            MoveScreen(hidden, 0, 1);
+            MoveScreen(hidden, 0, -1);
+        }
+        read_stats(&s1);
+        print_stats("full", &s0, &s1);
+        fprintf(out, "scene %s: full redraw %s\n", scene, hidden ? "done" : "NOT DONE (no screen)");
+        fflush(out);
+        Delay(150);
+        if (hidden)
+            CloseScreen(hidden);
+        if (front)
+            CloseWindow(front);
+    }
+    else if (!strcmp(test, "race") && glass[0])
+    {
+        /*
+         * Needs COMPOSITOR_FAULT_INJECTION=yes. Checks that marking a
+         * glass's blurred-background cache stale is never lost to a fill of
+         * that cache going on in another task at the same moment:
+         * 1. the cache is made stale (a change next to the glass composed
+         *    without the off-screen bitmap);
+         * 2. process A rewrites the glass: the cache is filled again and the
+         *    fill waits ("compositor.hold.blurfill") before it counts;
+         * 3. meanwhile process B makes another such change: it must wait for
+         *    A (the cache is guarded) and mark the cache stale after A;
+         * 4. A and B go on; then the glass rewrites itself once more. Its
+         *    background must be blurred again, not taken from the cache.
+         */
+        struct SignalSemaphore *hold, *fail;
+        struct Process *pa, *pb;
+        struct BlurStats h0, h1;
+        int waited = 0, k, rewait;
+
+        race_glass = glass[0];
+        race_back = back;
+        race_px = px;
+        race_parent = FindTask(NULL);
+        SetSignal(0, SIGBREAKF_CTRL_E | SIGBREAKF_CTRL_F);
+
+        /* 1 */
+        fail = race_name("compositor.fail.surfacebitmap");
+        SetAPen(back->RPort, 3);
+        RectFill(back->RPort, gpos[0][0] - BACKX - 3 - 8, gpos[0][1] - BACKY + 20, gpos[0][0] - BACKX - 3, gpos[0][1] - BACKY + 27);
+        race_unname(fail);
+
+        /* 2 */
+        hold = race_name("compositor.hold.blurfill");
+        if (hold)
+            ObtainSemaphore(hold);
+        read_stats(&h0);
+        pa = CreateNewProcTags(NP_Entry, (IPTR)race_fill, NP_Name, (IPTR)"backdropblur fill", TAG_DONE);
+        for (k = 0; k < 250; k++)
+        {
+            read_stats(&h1);
+            if (h1.held != h0.held)
+                break;
+            Delay(1);
+        }
+        fprintf(out, "race: fill held: %s\n", (h1.held != h0.held) ? "yes" : "NO (did not reach the hold point)");
+
+        /* 3 */
+        fail = race_name("compositor.fail.surfacebitmap");
+        race_b_done = 0;
+        pb = CreateNewProcTags(NP_Entry, (IPTR)race_invalidate, NP_Name, (IPTR)"backdropblur invalidate", TAG_DONE);
+        Delay(50);
+        waited = !race_b_done;
+        fprintf(out, "race: invalidation waits for the fill: %s\n", waited ? "yes" : "NO");
+
+        /* 4 */
+        if (hold)
+            ReleaseSemaphore(hold);
+        rewait = 0;
+        if (pa && pb)
+        {
+            ULONG got = 0;
+            while ((got & (SIGBREAKF_CTRL_E | SIGBREAKF_CTRL_F)) != (SIGBREAKF_CTRL_E | SIGBREAKF_CTRL_F) && rewait++ < 500)
+                got |= SetSignal(0, 0) & (SIGBREAKF_CTRL_E | SIGBREAKF_CTRL_F), Delay(1);
+        }
+        race_unname(fail);
+        race_unname(hold);
+        Delay(10);
+        read_stats(&s0);
+        WritePixelArray(px, 0, 0, GW * 4, glass[0]->RPort, 0, 0, GW, GH, RECTFMT_ARGB);
+        read_stats(&s1);
+        print_stats("after", &s0, &s1);
+        fprintf(out, "race: %s (after the race the glass was blurred %lu times and taken from the cache %lu times)\n",
+            (s1.cached == s0.cached && s1.blurs != s0.blurs) ? "PASS" : "FAIL",
+            (unsigned long)(s1.blurs - s0.blurs), (unsigned long)(s1.cached - s0.cached));
+    }
+    else if (!strcmp(test, "nomem"))
+    {
+        /*
+         * Needs a gfx.hidd built with COMPOSITOR_FAULT_INJECTION=yes. The
+         * first glass is blurred (the compositor's scratch buffer has its
+         * size). While the scratch buffer cannot grow, a larger glass
+         * (760x120 at 20,400) must show plain transparency, and the first
+         * one must stay blurred, also after a change next to it (the old
+         * buffer is kept and is large enough). Once memory is back, a
+         * redraw of the whole display blurs both.
+         */
+        struct SignalSemaphore *fail = AllocMem(sizeof(*fail), MEMF_PUBLIC | MEMF_CLEAR);
+        struct Window *big = NULL;
+        struct Screen *hidden;
