+    for (i = 0; i < 4; i++)
+        if (glass[i])
+            CloseWindow(glass[i]);
+    CloseWindow(back);
+    if (out != stdout) fclose(out);
+    CloseDevice((struct IORequest *)&treq);
+    free(times);
+    free(px);
+    if (rda) FreeArgs(rda);
+    return rc;
+}
