+/*
+ * PROTOTYPE (LA_BackdropBlur): fill in the request's extension. The
+ * display blurs what lies behind the layer, reading the screen bitmap
+ * around it as far as the blur reaches; but the screen bitmap there also
+ * holds the ordinary layers in front of this one. BlurFront says where:
+ * the visible parts of every uncomposited layer in front of it, within its
+ * bounds grown by the farthest reach (2 x the largest radius). Composited
+ * layers in front are not in the screen bitmap, so they do not count.
+ * Rebuilt with the surface list, which happens after every layer
+ * operation, so it follows windows moving in front.
+ */
+#define BLUR_MAX_REACH (2 * 16)
+
+static void _BlurRequest(struct Layer * l, struct LayersBase * LayersBase)
+{
+  struct HIDD_CompositeRequestExt * ext = &IL(l)->request;
+  struct Rectangle near = l->bounds;
+  struct Layer * f;
+  BOOL ok = TRUE;
+
+  ext->ExtSize      = sizeof(struct HIDD_CompositeRequestExt);
+  ext->BackdropBlur = IL(l)->backdropblur;
+  ext->ExtPad       = 0;
+  ext->BlurFront    = NULL;
+
+  near.MinX -= BLUR_MAX_REACH;
+  near.MinY -= BLUR_MAX_REACH;
+  near.MaxX += BLUR_MAX_REACH;
+  near.MaxY += BLUR_MAX_REACH;
+
+  if (NULL == IL(l)->blurfront)
+    IL(l)->blurfront = NewRegion();
+  if (NULL == IL(l)->blurfront)
