+            ULONG *tint = malloc(760 * 120 * 4);
+            int k;
+
+            if (tint)
+            {
+                for (k = 0; k < 760 * 120; k++)
+                    ((UBYTE *)&tint[k])[0] = 90, ((UBYTE *)&tint[k])[1] = 0xff,
+                    ((UBYTE *)&tint[k])[2] = 0xff, ((UBYTE *)&tint[k])[3] = 0xff;
+                WritePixelArray(tint, 0, 0, 760 * 4, big->RPort, 0, 0, 760, 120, RECTFMT_ARGB);
