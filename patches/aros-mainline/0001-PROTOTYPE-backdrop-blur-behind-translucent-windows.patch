--- /dev/null
+++ b/rom/graphics/layersurfacefeatures.c
@@ -0,0 +1,86 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: PROTOTYPE. What the display can do for composited layers'
+          surfaces beyond composing them. AROS private.
+*/
+
+#include <graphics/gfx.h>
+#include <hidd/gfx.h>
+#include <proto/oop.h>
+
+#include "graphics_intern.h"
+#include "gfxfuncsupport.h"
+
+/*****************************************************************************
+
+    NAME */
+#include <proto/graphics.h>
+
+        AROS_LH1(ULONG, LayerSurfaceFeatures,
+
+/*  SYNOPSIS */
+        AROS_LHA(struct BitMap *, screenbm, A0),
+
+/*  LOCATION */
+        struct GfxBase *, GfxBase, 206, Graphics)
+
+/*  FUNCTION
+        PROTOTYPE, not settled. Tells which extensions of a surface request
+        (struct HIDD_CompositeRequestExt) the display showing this screen
+        bitmap honours, as vHidd_CompositorSurface_* flags.
+
+    INPUTS
+        screenbm - the screen's bitmap
+
+    RESULT
+        0 when the bitmap's display cannot compose layers at all
+        (CompositeLayersSupported() is FALSE), when its compositor knows
+        no extension (older gfx.hidd), or when the compositor may scale
+        screens (a ModePolicy other than FollowTop): the blur is not done
+        on scaled screens, and whether this screen will be scaled cannot
+        be told in advance.
+
+    NOTES
+        AROS private, for intuition.library (SA_BackdropBlurSupport). Can
+        be moved at any moment. A feature reported here can still be left
+        out for a moment when memory is short; the surface is then shown
+        without it, as without the request.
+
+    SEE ALSO
+        CompositeLayersSupported(), LayerSurfacesChanged()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+    struct gfxdisplay_data *display;
+    OOP_Object *compositor = NULL;
+    IPTR features = 0, policy = 0;
+
+    if (!CompositeLayersSupported(screenbm, NULL))
+        return 0;
+
+    display = (struct gfxdisplay_data *)HIDD_BM_DRVDATA(screenbm);
+    OOP_GetAttr(display->display_obj, aHidd_Display_CompositionSurfaceFeatures, &features);
+    OOP_GetAttr(display->display_obj, aHidd_Display_Compositor, (IPTR *)&compositor);
+    if (compositor)
+    {
+        /* gfx.hidd's own attribute base is not obtained here: read the policy through the display */
+        OOP_AttrBase compbase = OOP_ObtainAttrBase(IID_Hidd_Compositor);
+
+        if (compbase)
+        {
+            OOP_GetAttr(compositor, compbase + aoHidd_Compositor_ModePolicy, &policy);
+            OOP_ReleaseAttrBase(IID_Hidd_Compositor);
+        }
+    }
+    if (policy != vHidd_Compositor_ModePolicy_FollowTop)
+        features = 0;
+
+    return (ULONG)features;
+
+    AROS_LIBFUNC_EXIT
+} /* LayerSurfaceFeatures */
