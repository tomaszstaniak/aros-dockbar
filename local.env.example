# Copy to ignored local.env and replace these placeholders with local paths.
# No script automatically loads this file. Export the values in your shell,
# or deliberately source your edited copy with: . ./local.env
# Sourcing replaces these environment variables; no precedence loader exists.
# Use absolute paths. AROS_SDK is the matching SDK's Development sysroot.
export DOCK_TARGET="x86_64-abiv11"
# Other release targets: x86_64-v1, aarch64-raspi-v1 (use matching tools).
export AROS_CC="/path/to/toolchain/x86_64-aros-gcc"
export AROS_SDK="/path/to/abiv11-sdk/Development"
export SVGICON_INCLUDE="/path/to/svgicon-dev/include"
export SVGICON_LIBRARY="/path/to/svgicon-dev/libs/svgicon.library"

# Optional: the default is the repository's build/x86_64-abiv11 directory.
# export DOCK_BUILD_DIR="/path/to/dockbar-build"
# Optional host test compiler; defaults to cc.
# export CC="cc"
